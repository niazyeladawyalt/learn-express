<header class>
  <nav class="bg-gray-800 w-full">
    <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">
      <div class="relative flex h-16 items-center justify-between">
        <ul class="main-header__item-list">
          <li class="main-header__item">
            <a class="<%= (typeof path !== 'undefined' && path === '/') ? 'active' : 'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>" href="/">Shop</a>

          </li>
          <li class="main-header__item">
            <a class="<%= (typeof path !== 'undefined' && path === '/products') ? 'active' : 'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>" href="/products">Products</a>
          </li>
          <% if (isLoggedIn) { %>
          <li class="main-header__item">
            <a class="<%= (typeof path !== 'undefined' && path === '/cart') ? 'active' : 'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>" href="/cart">Cart</a>
          </li>
          <li class="main-header__item">
            <a class="<%= (typeof path !== 'undefined' && path === '/orders') ? 'active' : 'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>" href="/orders">Orders</a>
          </li>

          <li class="main-header__item">
            <a class="<%= (typeof path !== 'undefined' && path === '/admin/add-product') ? 'active' : 'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>" href="/admin/add-product">Add Product</a>
          </li>
          <li class="main-header__item">
            <a class="<%= (typeof path !== 'undefined' && path === '/admin/products') ? 'active' : 'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>" href="/admin/products">Admin Products</a>
          </li>
          <% } %>
          <!-- <li class="main-header__item">
            <a class="<%= (typeof path !== 'undefined' && path === '/admin/users') ? 'active' : 'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>" href="/admin/users">
              Users</a>
          </li> -->
        </ul>

        <ul>
          <% if (!isLoggedIn) { %>

          <li>
            <ul class="flex items-center gap-4">
              <li>
                <a href="/login" class="<%= (typeof path !== 'undefined' && path === '/login') ? 'active' :'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>">Login</a>
              </li>
              <li>
                <a href="/signup" class="<%= (typeof path !== 'undefined' && path === '/signup') ? 'active' :'rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white' %>">Signup</a>
              </li>
            </ul>
          </li>
          <% } else { %>
          <li>
            <form action=" /logout" method="POST">
              <button class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white">Logout</button>
            </form>
          </li>
          <% } %>

        </ul>
      </div>
    </div>
  </nav>
</header>