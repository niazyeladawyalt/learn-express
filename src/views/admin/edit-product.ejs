<%- include('../includes/head.ejs') %>

<link rel="stylesheet" href="/css/forms.css" />
<link rel="stylesheet" href="/css/product.css" />
</head>

<body>
  <%- include('../includes/navigation.ejs') %>

  <main>
    <form class="product-form" action="/admin/<%= editing ? 'edit-product' : 'add-product' %>" method="POST" enctype="multipart/form-data">

      <%- include('../includes/validation-errors.ejs') %>
      <div class="form-control">
        <label for="title">Title</label>
        <input type="text" name="title" id="title" value="<%= typeof product !== 'undefined' && product.title ? product.title : '' %>" />
      </div>

      <div class="form-control">
        <label for="price">Price</label>
        <input type="number" name="price" id="price" step="0.01" value="<%= typeof product !== 'undefined' && product.price ? product.price : '' %>" />
      </div>

      <div class="form-control">
        <label for="description">Description</label>
        <textarea rows="4" name="description" id="description"><%= typeof product !== 'undefined' && product.description ? product.description : '' %></textarea>

      </div>

      <!-- <div class="form-control">
        <label for="imgUrl">Image URL</label>
        <input type="text" name="imgUrl" id="imgUrl" value="<%= typeof product !== 'undefined' && product.imgUrl ? product.imgUrl : '' %>" />
      </div> -->
      <div class="form-control">
        <label for="image">Image</label>
        <input type="file" name="image" id="image" />
      </div>
      <% if (editing) { %>
      <input type="hidden" name="id" value="<%= product._id %>">
      <% } %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn">
        <%= editing ? 'Edit Product' : 'Add Product' %>

      </button>
    </form>
  </main>

  <%- include('../includes/end.ejs') %>