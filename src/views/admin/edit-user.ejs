<%- include('../includes/head.ejs') %>

<link rel="stylesheet" href="/css/forms.css" />
<link rel="stylesheet" href="/css/product.css" />
</head>

<body>
  <%- include('../includes/navigation.ejs') %>

  <main>
    <div class="container mx-auto">
      <div class="w-1/2 mx-auto">
        <form class="user-form" action="/admin/<%= editing ? 'edit-user' : 'add-user' %>" method="POST">
          <div class="form-control">
            <label for="name">Name</label>
            <input type="text" name="name" id="name" value="<%= typeof user !== 'undefined' && user.name ? user.name : '' %>" />
          </div>

          <div class="form-control">
            <label for="email">Email</label>
            <input type="email" name="email" id="email" value="<%= typeof user !== 'undefined' && user.email ? user.email : '' %>" />
          </div>

          <% if (editing) { %>
            <input type="hidden" name="id" value="<%= user._id %>">
          <% } %>

          <button type="submit" class="btn">
            <%= editing ? 'Edit User' : 'Add User' %>
          </button>
        </form>
       </div>
    </div>

  </main>

  <%- include('../includes/end.ejs') %>
