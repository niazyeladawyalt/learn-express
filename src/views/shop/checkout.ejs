<%- include('../includes/head.ejs') %>

<link rel="stylesheet" href="/css/product.css" />
</head>

<body>
  <%- include('../includes/navigation.ejs') %>


  <div class="container mx-auto">


    <h1 class="my-8 text-4xl text-center  font-bold">Checkout</h1>

    <% if (cart.items.length> 0) { %>
    <div class="grid grid-cols-4 gap-8">


      <% for (let product of cart.items) { %>
      <div class="shadow rounded-2xl overflow-hidden">
        <div class=" aspect-16/12 bg-gray-200">

          <img src=" <%=  product.productId.imgUrl %>" class="h-full object-contain w-full" />
        </div>
        <div class="p-4">
          <h2 class="text-lg"> <%=  product.productId.title %> </h2>
          <p> price: $<%=  product.productId.price %> </p>

        </div>



      </div>
      <% }%>
    </div>

    <p class="my-8">Total Price: $<%=  cart.totalPrice %> </p>

    <!-- <form action="/create-order" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit">Order Now</button>

    </form> -->
    <form action="/create-checkout-session" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit">Pay with Stripe</button>
    </form>
    <% }%>
  </div>
  <%- include('../includes/end.ejs') %>