<%- include('../includes/head.ejs') %>

    <link rel="stylesheet" href="/css/product.css" />
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>


            <main class="py-8">
                <div class="container mx-auto">


                <h1 class="mb-8">Cart</h1>

                <% if (cart.items.length> 0) { %>
                        <div class="grid grid-cols-4 gap-8">


                        <% for (let product of cart.items) { %>
                            <div class="shadow rounded-2xl overflow-hidden">
                                <img src=" <%=  product.productId.imgUrl %>" />
                                <div class="p-4">
                                    <h2 class="text-lg"> <%=  product.productId.title %> </h2>
                                    <p> price: $<%=  product.productId.price %> </p>
                                    <form action="/cart-update" method="POST" class="flex items-center gap-2">
                                        <input type="hidden" name="productId" value="<%= product.productId._id %>">

                                        <!-- Decrease -->
                                        <button type="submit" name="change" value="-1" class="px-2 bg-gray-200 rounded">-</button>

                                        <!-- Quantity display -->
                                        <input type="number" name="quantity" value="<%= product.quantity %>" class="w-12 text-center border rounded" readonly>

                                        <!-- Increase -->
                                        <button type="submit" name="change" value="1" class="px-2 bg-gray-200 rounded">+</button>
                                    </form>

                                    <div class="py-4">
                                        <form action="/cart-delete" method="POST">
                                            <input type="hidden" name="productId" value="<%= product.productId._id %>">
                                            <button type="submit" class="bg-red-400 text-white px-4 py-2 rounded cursor-pointer">
                                            Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>



                            </div>
                        <% }%>
                        </div>

                        <p class="my-8">Total Price: $<%=  cart.totalPrice %> </p>

                        <form action="/create-order" method="POST">
                            <button type="submit">Order Now</button>

                        </form>
                    <% }%>
                </div>

            </main>
            <%- include('../includes/end.ejs') %>